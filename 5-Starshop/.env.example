# Copy this file to ".env" before starting the project:
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
#
# Example values for local development only.
# Never put production secrets in this file.

###> doctrine/doctrine-bundle ###
# Used by docker compose to initialise the Postgres password.
# Must match the password in DATABASE_URL below.
POSTGRES_PASSWORD=!ChangeMe!
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:55432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/framework-bundle ###
APP_ENV=dev
# Generate a random value, e.g.: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=change-me-with-a-random-32-char-string
APP_SHARE_DIR=var/share
ISS_LOCATION_CACHE_TTL=5
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/mercure-bundle ###
MERCURE_URL=https://example.com/.well-known/mercure
MERCURE_PUBLIC_URL=https://example.com/.well-known/mercure
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###
