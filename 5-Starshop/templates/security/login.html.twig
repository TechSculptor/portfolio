{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <div class="max-w-sm mx-auto mt-16 px-5">
        <h1 class="text-[32px] font-semibold border-b border-white/10 pb-5 mb-8">Log in</h1>

        {% if error %}
            <div class="bg-red-400/30 rounded-lg px-4 py-2.5 mb-5 text-sm">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div class="mb-4">
                <label for="username" class="block text-sm text-gray-300 mb-1">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="username" class="w-full rounded-lg bg-white/5 border border-white/10 px-3 py-2" autocomplete="email" required autofocus>
            </div>
            <div class="mb-5">
                <label for="password" class="block text-sm text-gray-300 mb-1">Password</label>
                <input type="password" name="_password" id="password" class="w-full rounded-lg bg-white/5 border border-white/10 px-3 py-2" autocomplete="current-password" required>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <button class="text-white bg-green-700 hover:bg-green-800 rounded-lg px-5 py-2.5 cursor-pointer w-full" type="submit">Log in</button>
        </form>
    </div>
{% endblock %}
