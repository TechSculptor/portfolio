{
  // Ctrl+Maj+P > « Tasks: Run Task » > « Voir le site en local »
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serveur Python (port 8000)",
      "type": "shell",
      "command": "python -m http.server 8000",
      "isBackground": true,
      "problemMatcher": {
        "owner": "http-server",
        "pattern": { "regexp": "^__never__$" },
        "background": { "activeBegins": true, "beginsPattern": "Serving HTTP", "endsPattern": "Serving HTTP" }
      },
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "Voir le site en local",
      "type": "shell",
      "command": "Start-Sleep -Seconds 1; Start-Process http://localhost:8000/",
      "windows": { "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } } },
      "dependsOn": "Serveur Python (port 8000)",
      "problemMatcher": [],
      "presentation": { "reveal": "never" }
    },
    {
      "label": "Compiler le CSS Tailwind",
      "type": "shell",
      "command": "npx tailwindcss@3 -i assets/css/input.css -o assets/css/site.css --minify",
      "problemMatcher": []
    }
  ]
}
